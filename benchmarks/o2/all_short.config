process {
    queue = 'short'

    withName: RUN_METHYLSEQ {
        queue = 'short'
        cpus = 8
        memory = 32.GB
        time = 4.h
    }

    withName: PARSE_PAIRS {
        queue = 'short'
        cpus = 4
        memory = 8.GB
        time = 1.h
    }

    withName: ANNOTATE_PAIRS {
        queue = 'short'
        cpus = 1
        memory = 2.GB
        time = 30.m
    }

    withName: VALIDATE_PAIRS {
        queue = 'short'
        cpus = 1
        memory = 1.GB
        time = 15.m
    }
}
