// Inner nf-core/methylseq config for O2 benchmark chunks.
// Main intent: remove embedded Trim Galore FastQC, use more Trim Galore/BWA threads.

params {
    input        = 'samplesheet.csv'
    outdir       = 'results'
    genome       = null
    aligner      = 'bwameth'

    max_cpus     = 16
    max_memory   = '64.GB'
    max_time     = '72.h'

    skip_fastqc  = true
    skip_multiqc = false

    trace_enabled    = true
    timeline_enabled = true
    report_enabled   = true
}

process {
    cpus   = 2
    memory = '4.GB'
    time   = '8.h'

    withName: 'BWAMETH_INDEX' {
        cpus   = 4
        memory = '8.GB'
        time   = '8.h'
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:TRIMGALORE' {
        cpus   = 12
        memory = '24.GB'
        time   = '8.h'
        ext.args = ''
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMETH:BWAMETH_ALIGN' {
        cpus   = 12
        memory = '48.GB'
        time   = '48.h'
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMETH:SAMTOOLS_SORT' {
        cpus   = 4
        memory = '8.GB'
        time   = '12.h'
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMETH:SAMTOOLS_INDEX_ALIGNMENTS' {
        cpus   = 2
        memory = '4.GB'
        time   = '4.h'
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMETH:SAMTOOLS_FLAGSTAT' {
        cpus   = 2
        memory = '4.GB'
        time   = '4.h'
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMETH:SAMTOOLS_STATS' {
        cpus   = 2
        memory = '4.GB'
        time   = '4.h'
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMETH:PICARD_MARKDUPLICATES' {
        cpus   = 4
        memory = '8.GB'
        time   = '12.h'
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMETH:SAMTOOLS_INDEX_DEDUPLICATED' {
        cpus   = 2
        memory = '4.GB'
        time   = '4.h'
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMETH:METHYLDACKEL_EXTRACT' {
        cpus   = 4
        memory = '16.GB'
        time   = '24.h'
    }

    withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BWAMETH:METHYLDACKEL_MBIAS' {
        cpus   = 4
        memory = '8.GB'
        time   = '12.h'
    }
}

executor {
    name = 'local'
    cpus = 16
}

docker.enabled = false
singularity.enabled = false
conda.enabled = true
conda.useMamba = true
workDir = './work'
cleanup = false
