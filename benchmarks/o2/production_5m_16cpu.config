process {
    queue = 'short'

    withName: RUN_METHYLSEQ {
        queue = 'short'
        cpus = 16
        memory = 64.GB
        time = 12.h
        beforeScript = 'module load conda/miniforge3/24.11.3-0; export NXF_CONDA_CACHEDIR=/home/mja8/projects/methyl-microc/benchmarks/o2/nextflow-conda-cache'
    }

    withName: POSTPROCESS_PAIRS {
        conda = '/n/data1/dfci/pathonc/johnstone/lab/huc530/methyl_microc_lab/prebuilt_envs/pairtools'
        queue = 'short'
        cpus = 8
        memory = 32.GB
        time = 12.h
    }
}

conda {
    cacheDir = '/home/mja8/projects/methyl-microc/benchmarks/o2/outer-conda-cache'
}
